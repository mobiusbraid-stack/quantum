use std::vec::Vec;

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum BraidGenerator {
    Sigma(usize),    // Standard generator σ_i (over-strand swap)
    SigmaInv(usize), // Inverse generator σ_i^-1 (under-strand swap)
}

pub struct HomotopyBraidTracer {
    pub strands: usize,
    pub word: Vec<BraidGenerator>,
}

impl HomotopyBraidTracer {
    pub fn new(strands: usize) -> Self {
        Self {
            strands,
            word: Vec::new(),
        }
    }

    /// Appends a generator to the braid word
    pub fn push_generator(&mut self, gen: BraidGenerator) {
        self.word.push(gen);
    }

    /// Applies Markov moves and braid relation reduction (σ_i σ_{i+1} σ_i = σ_{i+1} σ_i σ_{i+1})
    pub fn reduce_homotopy_class(&mut self) {
        let mut reduced = Vec::new();
        let mut i = 0;
        
        while i < self.word.len() {
            // Cancel adjacent inverse generators: σ_i * σ_i^-1 = id
            if i + 1 < self.word.len() {
                match (&self.word[i], &self.word[i + 1]) {
                    (BraidGenerator::Sigma(a), BraidGenerator::SigmaInv(b)) if a == b => {
                        i += 2;
                        continue;
                    },
                    (BraidGenerator::SigmaInv(a), BraidGenerator::Sigma(b)) if a == b => {
                        i += 2;
                        continue;
                    },
                    _ => {}
                }
            }
            reduced.push(self.word[i].clone());
            i += 1;
        }
        self.word = reduced;
    }

    /// Computes the Jones/Kauffman bracket invariant polynomial trace for phase calibration
    pub fn evaluate_tangle_moduli_phase(&self) -> f64 {
        let writhe: i32 = self.word.iter().map(|g| match g {
            BraidGenerator::Sigma(_) => 1,
            BraidGenerator::SigmaInv(_) => -1,
        }).sum();

        // Phase angle mapped to 39,420 Hz baseband carrier modulation
        let base_freq = 39420.0;
        let phase_offset = (writhe as f64) * std::f64::consts::PI / 4.0;
        
        base_freq + phase_offset.sin()
    }
}
